node_modules/
.pnpm-store/

# Build outputs
dist/
build/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Test coverage
coverage/

# Superpowers brainstorm sessions
.superpowers/

# Superpowers worktrees (isolated dev branches)
.worktrees/

# Mascot build tmp
.mascot-tmp/

# SFX synth tmp (wav intermediates + script)
.sfx-tmp/

# ComfyUI / image generation experiment outputs
/comfyui-output/
/public/
audit-report.json
verify-report.json
sparkle-success.json

# Icon design working files (AI generation sources, ~18MB, regenerable)
design/

# Temp R2 inspection JSON files
.tmp-*.json
_*.json
jack-*.json
# …but the series SCENE notes are authored content, not a dump. `_*.json` had been
# swallowing 250 pages per series since 2026-08-13, tracked nowhere but one disk.
!docs/changjak-books/*/_scenes.json

# Dev-only analysis dumps (key-object editor)
packages/client/public/_analysis/
# _data 는 dump/산출물(gitignore) 이지만 translations/ 는 번역 소스, marketing/base-articles/ 는 마케팅 기본글 템플릿으로 보존
packages/server/scripts/_data/*
!packages/server/scripts/_data/translations/
!packages/server/scripts/_data/marketing/
!packages/server/scripts/_data/marketing/base-articles/
!packages/server/scripts/_data/marketing/keyword-plans/
# keyword-plans 의 _titles.json·_main-keywords.json 은 _*.json 규칙(위)에 막히므로 명시 예외
!packages/server/scripts/_data/marketing/keyword-plans/_titles.json
!packages/server/scripts/_data/marketing/keyword-plans/_main-keywords.json

# .claude session backups
.claude/backups/


# Lottie / effects preview (local dev tool)
lottie-samples/

# Claude Code isolated worktrees
.claude/worktrees/

# Server render outputs + local backup dumps (large binaries / not source)
packages/server/out/
packages/client/out/
# 키포인트 검수용 미리보기 — 볼 때만 만들고 버린다
packages/server/scripts/_preview-keypoints/
packages/server/scripts/_preview-coloring/
packages/server/scripts/_preview-coloring-raw/
packages/server/scripts/_backup*/

# 학습만화 자산은 R2 저장(comic-assets.routes.ts) — 리포에 커밋하지 않음
packages/client/public/comic-assets/

# Encrypted Meta token bundle for one-off ad-reel publish (local secret, never commit)
packages/server/scripts/_enc.txt

# YouTube Shorts 자동 업로드 런타임 상태 (매 실행마다 갱신 — 로컬 기록, 커밋 안 함)
docs/marketing/drafts/shorts-upload-state.json

# WIA award reference images — internal viewing only, never commit/deploy (copyright)
packages/client/public/_wia-refs/

# 파닉스 카드 keypoints 추출 작업 캐시 (원본 이미지 + rembg 마스크, 수십 MB)
packages/server/scripts/_word-card-cache/
packages/server/scripts/_keyobject-cache/
scratch/

# 네이버 블로그 로컬 세션 (절대 커밋 금지)
naver-session.json
packages/server/naver-session.json

# 마케팅 영상 산출물 — R2·유튜브·IG 로 나가는 결과물이라 저장소에 둘 이유가 없다.
# 🔴 여기 빠져 있어서 재렌더할 때마다 새 blob 이 쌓였다(ad-reel-phonics.mp4 만 5벌, 히스토리 ~280MB).
# ⚠️ packages/remotion/public/**/*.mp4 는 제외하지 않는다 — 그건 산출물이 아니라 광고 릴스 **실촬 소재**다.
docs/marketing/*.mp4

# 한글 워크지 생성물 — build-worksheet.mjs 가 언제든 다시 만든다.
# 🔴 고르기 화면 둘만 배포한다(ko_phonics · en_phonics). 각각 전 단원이 통째로 들어 있고
#    인쇄하면 고른 단원만 나간다 — 나머지 단원 파일과 합본은 같은 그림을 두세 벌 든 사본이라 뺀다.
#    (하위 경로를 되살리려면 `dir/` 이 아니라 `dir/*` 여야 한다 — 디렉터리째 무시하면 예외가 안 먹는다)
packages/client/public/worksheet/*
!packages/client/public/worksheet/ko_phonics.html
!packages/client/public/worksheet/en_phonics.html
packages/server/scripts/_preview-flat/
docs/changjak-books/*/_drafts/
