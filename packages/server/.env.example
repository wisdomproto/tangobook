PORT=3000
NODE_ENV=development

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Leda

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=storybook-images
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# TTS Providers (optional)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
ELEVENLABS_API_KEY=

# Speaking games — Whisper fallback (optional; iOS Safari degrades to silent pass-through without it)
# OPENAI_API_KEY=sk-...

# Frontend URL (for CORS in production)
CLIENT_URL=http://localhost:5173

# Naver AD API (existing — keyword search via marketing service)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# ── Marketing Phase 0+ (all optional; server boots without these) ──────────────

# Google Analytics 4 (Data API — service account)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Meta (Facebook) Graph API
META_APP_ID=
META_APP_SECRET=
# Meta OAuth 연동(발행) — 아래 3개는 계정 연동/자동 발행에 필요
#  META_REDIRECT_BASE: OAuth 콜백 베이스(공개 HTTPS 도메인, 예: https://api.tangobook.co.kr).
#    Meta 앱 설정 > 유효한 OAuth 리디렉션 URI 에 "{META_REDIRECT_BASE}/api/auth/meta/callback" 등록.
#  META_TOKEN_ENC_KEY: 토큰 at-rest 암호화 키(base64 32바이트). 생성: openssl rand -base64 32
#  CORS_ORIGIN: 연동 완료 후 돌아올 SPA origin(예: https://tangobook.co.kr).
META_REDIRECT_BASE=
META_TOKEN_ENC_KEY=
CORS_ORIGIN=

# YouTube Data API v3 (separate from OAuth upload key above)
YOUTUBE_DATA_API_KEY=

# DataForSEO
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Naver Datalab (trend search — separate from Naver AD above)
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_SECRET=

# Supabase service-role (marketing publish scheduler — server-only, NEVER expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: guards the manual publish-tick debug endpoint
CRON_SECRET=

# Toss Payments — 토스 시크릿키(테스트: test_sk_... / 운영: live_sk_...)
TOSS_SECRET_KEY=
