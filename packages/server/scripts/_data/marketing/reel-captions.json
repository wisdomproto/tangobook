{
  "1772009873865": [
    "황금 공이 연못에 빠지며\n시작된 이야기",
    "그림 형제 동화집의\n맨 첫 번째 이야기",
    "공을 찾아준 개구리와의 약속,\n그리고 놀라운 변신",
    "약속은 꼭 지키고\n겉모습보다 마음을 봐요"
  ],
  "1772082243436": [
    "여름내 노래한 베짱이,\n부지런히 모은 개미",
    "2천 년 전\n이솝이 남긴 우화",
    "겨울이 오자\n베짱이는 어떻게 됐을까요?",
    "미리 준비하는 지혜와\n친구를 돕는 따뜻함"
  ],
  "1772084667220": [
    "정원에만\n겨울이 계속된 이유는?",
    "오스카 와일드의\n1888년 명작 동화",
    "담을 쌓자 사라진 봄,\n아이들과 함께 돌아온 봄",
    "나눌 때 비로소\n봄이 찾아와요"
  ],
  "1772085655331": [
    "소인국과 거인국을\n오가는 대모험",
    "1726년,\n조나단 스위프트의 이야기",
    "거인이 됐다가\n작아지기도 하는 여행",
    "크기가 달라도\n마음의 크기는 같아요"
  ],
  "1772086769057": [
    "밤마다 구두를 만들어 준 건\n누구였을까요?",
    "그림 형제의\n「요정과 구두장이」",
    "요정이 도와준 구둣방,\n노부부의 따뜻한 보답",
    "도움은 주고받을 때\n더 따뜻해져요"
  ],
  "1772088321757": [
    "빈 집에 몰래 들어간\n골디락스",
    "영국에서 전해 내려온\n전래 동화",
    "죽도 의자도 침대도\n'딱 알맞은' 걸 찾아요",
    "남의 물건은\n함부로 쓰면 안 돼요"
  ],
  "1777276113613": [
    "눈의 여왕에게 끌려간\n친구를 구하러",
    "안데르센의\n1844년 긴 동화",
    "게르다가 사계절을 지나\n얼음 궁전으로",
    "진실한 우정은\n차가운 마음도 녹여요"
  ],
  "1777276046428": [
    "엄마가 없는 사이\n찾아온 늑대",
    "그림 형제가 남긴\n1812년 이야기",
    "목소리와 발을 꾸민 늑대,\n시계 속에 숨은 막내",
    "달콤한 말과 모습에\n속지 말아요"
  ],
  "1777272102062": [
    "높은 탑에 갇힌\n긴 머리 소녀",
    "그림 형제 동화집의\n이야기",
    "'머리카락을 내려 다오',\n탑을 벗어나는 용기",
    "갇힌 순간에도\n희망을 잃지 않아요"
  ],
  "1772093674655": [
    "형제들과 달라\n미움받던 아기 새",
    "안데르센이\n자신의 삶을 담은 동화",
    "외로운 겨울을 견디자\n찾아온 봄",
    "나의 진짜 가치는\n내가 발견하는 거예요"
  ],
  "1778555233699": [
    "'거울아, 거울아'\n누가 가장 예쁘니?",
    "그림 형제의\n1812년 민담",
    "질투한 왕비의 독사과,\n일곱 난쟁이의 집",
    "진실한 마음은\n끝내 빛나요"
  ],
  "1772094228783": [
    "백조가 된 오빠 열한 명을\n구하려면?",
    "안데르센의\n1838년 동화",
    "말 한마디 없이\n쐐기풀 옷을 짜는 엘리자",
    "사랑을 위한 인내는\n기적을 만들어요"
  ],
  "1772094591661": [
    "낮에는 백조,\n밤에는 사람인 공주",
    "차이코프스키의\n명작 발레",
    "마법사의 계략을 넘어\n지키는 진심",
    "진실한 사랑은\n어둠도 이겨내요"
  ],
  "1777284655559": [
    "보물 지도를 손에 넣은\n소년의 항해",
    "1883년,\n스티븐슨의 모험 소설",
    "배에 숨어든 해적들 사이,\n짐의 용기와 지혜",
    "위험 앞에서도\n침착하면 길이 열려요"
  ],
  "1777274748674": [
    "누가 더 셀까?\n북풍과 태양의 내기",
    "2천 년 전\n이솝의 우화",
    "바람이 셀수록\n외투를 꽉 여미는 나그네",
    "따뜻하게 다가갈 때\n마음이 움직여요"
  ],
  "1772097729467": [
    "쫓겨난 네 동물이\n힘을 합치면?",
    "그림 형제가 남긴\n독일 이야기",
    "당나귀·개·고양이·수탉,\n도둑을 놀래 준 합창",
    "서로의 부족함을 채우면\n새 길이 열려요"
  ],
  "1772098071249": [
    "화려한 빨간 구두에\n마음을 빼앗긴 소녀",
    "안데르센의\n1845년 동화",
    "구두만 생각하다\n곤란에 빠진 카렌",
    "진짜 아름다움은\n마음에서 와요"
  ],
  "1778476961082": [
    "할머니 집으로 가던 길,\n만난 늑대",
    "페로와 그림 형제의\n유럽 민담",
    "먼저 할머니 집에 가\n변장한 늑대",
    "낯선 사람에게\n함부로 말하지 말아요"
  ],
  "1777277632597": [
    "상상력이 넘치는\n고아 소녀 앤",
    "1908년,\n몽고메리의 성장 소설",
    "실수해도 씩씩하게,\n마을을 환하게 바꿔요",
    "긍정의 힘과\n다시 일어서는 용기"
  ],
  "1772106564046": [
    "'날 잡아 봐라!'\n도망치는 생강빵",
    "영미권에 퍼진\n전래 동화",
    "아무도 못 잡던 생강빵,\n여우의 꾐에 넘어가요",
    "자만은 방심을 부르고\n낯선 꾐은 조심해요"
  ],
  "1777274769616": [
    "다리가 하나뿐인\n작은 주석 병정",
    "안데르센의\n1838년 동화",
    "종이배를 타고 떠돌아도\n울지 않는 병정",
    "약점이 있어도\n마음은 당당하게"
  ],
  "1772106779761": [
    "추운 그믐날 밤,\n성냥을 켜자",
    "안데르센의\n1845년 동화",
    "불빛 속에 나타난\n난로와 할머니",
    "추운 이웃을 돌아보는\n따뜻한 마음"
  ],
  "1777277635476": [
    "부유했던 소녀가\n하녀가 된다면?",
    "1905년,\n버넷의 이야기",
    "힘든 처지에도\n품위를 잃지 않는 세라",
    "어떤 처지에서도\n친절할 수 있어요"
  ],
  "1772107608499": [
    "착한 마음은\n약한 걸까요?",
    "힘든 집안일 속에도\n미소를 잃지 않았어요",
    "호박은 마차로,\n누더기는 드레스로",
    "자정 종소리,\n남겨진 유리 구두 한 짝"
  ],
  "1777284662626": [
    "바다를 사랑한 상인의\n일곱 번의 항해",
    "『천일야화』에 실린\n고전 모험담",
    "섬인 줄 알았던 고래,\n거대한 새 로크",
    "낯선 곳에서도\n침착하면 길이 보여요"
  ],
  "1772108045716": [
    "짚·나무·벽돌,\n누구 집이 튼튼할까요?",
    "영국에서 전해 내려온\n전래 동화",
    "'후!' 날아간 두 집,\n끄떡없던 벽돌집",
    "성실하게 준비하면\n나를 지켜요"
  ],
  "1772108468177": [
    "요술 램프 속\n지니가 나타나면?",
    "『천일야화』에 실린\n모험 이야기",
    "마법사의 위기를\n기지로 이겨내는 알라딘",
    "정직한 마음을\n끝까지 지켜요"
  ],
  "1777277215628": [
    "작은 별에서 온\n어린 왕자",
    "1943년,\n생텍쥐페리의 명작",
    "사막의 비행사에게\n들려주는 별들의 이야기",
    "가장 중요한 건\n마음으로 보여요"
  ],
  "1772108847406": [
    "엄지손가락만 한\n작은 소녀",
    "안데르센의\n1835년 동화",
    "여러 위기를 지나\n따뜻한 꽃의 나라로",
    "작고 약해도\n용기와 친절을 잃지 않아요"
  ],
  "1772109314126": [
    "회오리에 휩쓸려\n도착한 오즈 나라",
    "1900년,\n바움의 이야기",
    "허수아비·나무꾼·사자와\n마법사를 찾아서",
    "소중한 건 이미\n내 안에 있어요"
  ],
  "1772181211472": [
    "다리 밑 괴물 트롤을\n어떻게 넘을까요?",
    "노르웨이의\n전래 동화",
    "'더 큰 형이 올 거예요',\n지혜로 넘긴 세 염소",
    "겁날 때도 지혜롭게,\n필요할 땐 용기를"
  ],
  "1772182206245": [
    "토끼 굴로 떨어진\n앨리스",
    "1865년,\n루이스 캐럴의 이야기",
    "커졌다 작아지고\n여왕의 재판까지",
    "호기심으로 탐험하는\n즐거움"
  ],
  "1772181399388": [
    "바닷속 공주가\n인간을 사랑하면?",
    "안데르센의\n1837년 동화",
    "목소리를 내어주고\n뭍으로 오른 인어 공주",
    "선택에는\n마음과 책임이 따라요"
  ],
  "1772194909157": [
    "물레 바늘에 찔려\n잠든 공주",
    "페로와 그림 형제의\n동화",
    "온 성이 함께 잠들고,\n오랜 세월 뒤 깨어나요",
    "희망을 잃지 않으면\n좋은 날이 와요"
  ],
  "1772197180029": [
    "늑대 무리에서 자란\n소년 모글리",
    "1894년,\n키플링의 이야기",
    "곰 발루·표범 바기라와\n호랑이를 이겨내요",
    "서로 다른 존재도\n우정으로 가족이 돼요"
  ],
  "1772197611601": [
    "어마어마하게 큰 순무,\n뽑을 수 있을까요?",
    "러시아의\n전래 동화",
    "온 가족이 매달려도\n꿈쩍 않던 순무",
    "작은 힘도 모으면\n큰일을 해내요"
  ],
  "1777284715922": [
    "얼굴도 모르는 후원자에게\n쓰는 편지",
    "1912년,\n진 웹스터의 성장 소설",
    "긴 그림자 때문에 붙인 이름,\n'키다리 아저씨'",
    "따뜻한 관심과 믿음이\n꿈을 키워요"
  ],
  "1777276044172": [
    "빠른 토끼와 느린 거북이,\n누가 이길까요?",
    "이솝의\n오래된 우화",
    "앞서가던 토끼가\n낮잠에 빠진 사이",
    "꾸준함이\n재능을 이겨요"
  ],
  "1777284718837": [
    "행복을 주는 파랑새는\n어디에 있을까요?",
    "1908년,\n마테를링크의 희곡",
    "먼 나라를 여행해도\n잡지 못한 파랑새",
    "행복은 이미\n내 곁에 있어요"
  ],
  "1777277618365": [
    "화가를 꿈꾸는 소년과\n충직한 개",
    "1872년,\n위다의 소설",
    "가난 속에서도 서로 의지하는\n네로와 파트라슈",
    "끝까지 곁을 지키는\n진실한 우정"
  ],
  "1777266835789": [
    "거짓말하면\n코가 길어지는 인형",
    "1883년,\n콜로디의 이야기",
    "여러 시련을 지나며\n정직과 용기를 배워요",
    "정직·성실·용기가\n진짜 사람다움을 만들어요"
  ],
  "1772198278145": [
    "피리 소리로\n쥐 떼를 쫓은 사나이",
    "독일 하멜른 마을의\n오랜 전설",
    "약속한 보상을 주지 않자\n실망한 사나이",
    "약속을 어기면\n신뢰를 잃어요"
  ],
  "1772198919301": [
    "용감한 피터가\n늑대를 잡는 법",
    "프로코피예프의\n음악 동화",
    "새와 힘을 합쳐\n밧줄로 늑대를 붙잡아요",
    "용기와 지혜로 맞서면\n큰일도 해내요"
  ],
  "1777284736052": [
    "알프스 산골로 온\n밝은 소녀 하이디",
    "1880년,\n슈피리의 소설",
    "건초 침대에 '구름 같다',\n산 생활에 행복해해요",
    "밝고 순수한 마음이\n닫힌 마음도 열어요"
  ],
  "1772199288387": [
    "황금 동상과 제비가\n이웃을 돕는다면?",
    "1888년,\n오스카 와일드의 동화",
    "루비와 사파이어, 금까지\n나눠 준 왕자",
    "나눌 때\n진정한 행복이 와요"
  ],
  "1772201758726": [
    "크리스마스 밤,\n살아난 호두까기 인형",
    "호프만의 소설,\n차이코프스키의 발레",
    "생쥐 왕을 물리치고\n과자 나라로",
    "친구를 돕는 용기와\n상상의 기쁨"
  ]
}
