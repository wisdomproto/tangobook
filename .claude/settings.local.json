  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; d=json.load(sys.stdin); cmd=d.get('tool_input',{}).get('command',''); exit(0 if cmd.startswith('git push') else 1)\" && pnpm typecheck && pnpm build",
            "timeout": 180,
            "statusMessage": "Push 전 typecheck + build 검증 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; d=json.load(sys.stdin); cmd=d.get('tool_input',{}).get('command',''); exit(0 if cmd.startswith('git push') else 1)\" && BRANCH=$(git rev-parse --abbrev-ref HEAD) && if [ \"$BRANCH\" != 'main' ]; then git checkout main && git merge \"$BRANCH\" --no-edit && git push && git checkout \"$BRANCH\"; fi",
            "timeout": 120,
            "statusMessage": "main 브랜치에 merge + push 중..."
          }
        ]
      }
    ]
  }
