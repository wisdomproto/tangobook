  "titles": [
    {
      "text": "백설공주",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "18.816px"
    },
    {
      "text": "신데렐라",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "인어 공주",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "백설공주",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "잠자는 숲속의 공주",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "잭과 콩나무",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "토끼와 거북이",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "정글북",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "라푼젤",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "반쪽이",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "두더지의 혼인",
      "font": "\"TangoBook Story Hand Global\", \"TangoBook Story Hand Global\", sans-serif",
      "size": "25.088px"
    },
    {
      "text": "구렁덩덩 새선비",
